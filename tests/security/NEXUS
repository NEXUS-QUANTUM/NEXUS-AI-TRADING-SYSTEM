# ----- Session Management Tests -----

class TestSessionManagement:
    """Tests for session management and security."""

    def test_session_expiration(self, client: TestClient, test_user: User):
        """Test that session expires after token expiration."""
        # Create a short-lived token
        with patch('backend.security.auth.datetime') as mock_datetime:
            mock_datetime.utcnow.return_value = datetime.utcnow() + timedelta(hours=1)
            token = create_access_token(data={"sub": test_user.id})
        # Wait for token to expire (mock)
        with patch('backend.security.auth.datetime') as mock_datetime:
            mock_datetime.utcnow.return_value = datetime.utcnow() + timedelta(hours=2)
            headers = {"Authorization": f"Bearer {token}"}
            response = client.get("/api/v1/users/me", headers=headers)
            assert response.status_code == 401

    def test_concurrent_sessions(self, client: TestClient, test_user: User):
        """Test that multiple sessions can exist simultaneously."""
        token1 = create_access_token(data={"sub": test_user.id})
        token2 = create_access_token(data={"sub": test_user.id})
        headers1 = {"Authorization": f"Bearer {token1}"}
        headers2 = {"Authorization": f"Bearer {token2}"}
        response1 = client.get("/api/v1/users/me", headers=headers1)
        response2 = client.get("/api/v1/users/me", headers=headers2)
        assert response1.status_code == 200
        assert response2.status_code == 200

    def test_session_logout(self, client: TestClient, auth_headers: Dict):
        """Test that logout invalidates the session."""
        response = client.post("/api/v1/auth/logout", headers=auth_headers)
        assert response.status_code == 204
        # Try to access protected endpoint
        response = client.get("/api/v1/users/me", headers=auth_headers)
        assert response.status_code == 401


