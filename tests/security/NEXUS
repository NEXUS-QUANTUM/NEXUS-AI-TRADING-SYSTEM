# ----- Audit Logging Tests -----

class TestAuditLogging:
    """Tests for audit logging."""

    def test_audit_log_on_login(self, client: TestClient, db_session: Session):
        """Test that a login event is logged in audit log."""
        # Count audit logs before login
        before_count = db_session.query(AuditLog).count()

        # Perform login
        response = client.post(
            "/api/v1/auth/login",
            json={"email": "test@nexusquantum.com", "password": "Test@123"}
        )
        assert response.status_code == 200

        # Check that an audit log was created
        after_count = db_session.query(AuditLog).count()
        assert after_count > before_count
        log = db_session.query(AuditLog).order_by(AuditLog.created_at.desc()).first()
        assert log.action == "login"
        assert log.user_id is not None

    def test_audit_log_on_order_placement(self, client: TestClient, auth_headers: Dict, db_session: Session):
        """Test that placing an order creates an audit log."""
        before_count = db_session.query(AuditLog).count()
        response = client.post(
            "/api/v1/trading/orders",
            json={"symbol": "AAPL", "side": "buy", "quantity": 1, "order_type": "market"},
            headers=auth_headers
        )
        assert response.status_code in [200, 201, 400]
        after_count = db_session.query(AuditLog).count()
        # Should have at least one log for the order attempt (even if failed)
        assert after_count > before_count

    def test_audit_log_sensitive_data_redaction(self, client: TestClient, db_session: Session):
        """Test that sensitive data is redacted from audit logs."""
        # Login with password; the audit log should not store the password
        response = client.post(
            "/api/v1/auth/login",
            json={"email": "test@nexusquantum.com", "password": "Test@123"}
        )
        log = db_session.query(AuditLog).order_by(AuditLog.created_at.desc()).first()
        # Check that password is not in the log
        assert "password" not in str(log.details)


