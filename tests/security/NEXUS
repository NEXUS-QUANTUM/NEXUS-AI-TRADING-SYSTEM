# ----- Authentication Tests -----

class TestAuthentication:
    """Tests for authentication mechanisms."""

    def test_jwt_token_creation(self, test_user: User):
        """Test JWT token creation and validation."""
        token = create_access_token(data={"sub": test_user.id})
        assert token is not None
        assert len(token) > 20

        # Verify token
        payload = verify_token(token)
        assert payload is not None
        assert payload.get("sub") == test_user.id

    def test_jwt_token_expiration(self, test_user: User):
        """Test that expired tokens are rejected."""
        with patch('backend.security.auth.datetime') as mock_datetime:
            # Set expiry to past
            mock_datetime.utcnow.return_value = datetime.utcnow() - timedelta(days=1)
            token = create_access_token(data={"sub": test_user.id})
            # Verify should fail
            payload = verify_token(token)
            assert payload is None

    def test_refresh_token_flow(self, client: TestClient, test_user: User):
        """Test refresh token flow."""
        refresh = create_refresh_token(data={"sub": test_user.id})
        response = client.post(
            "/api/v1/auth/refresh",
            json={"refresh_token": refresh}
        )
        assert response.status_code == 200
        data = response.json()
        assert "access_token" in data
        assert "refresh_token" in data

    def test_login_rate_limiting(self, client: TestClient):
        """Test rate limiting on login endpoint."""
        # Attempt multiple logins with wrong credentials
        for i in range(6):
            response = client.post(
                "/api/v1/auth/login",
                json={"email": "test@example.com", "password": "wrong"}
            )
            if i < 5:
                assert response.status_code == 401
            else:
                # Should be rate limited (429)
                assert response.status_code == 429
                data = response.json()
                assert "retry-after" in data or "rate limit" in data["detail"].lower()

    def test_brute_force_protection(self, client: TestClient):
        """Test brute force protection on login."""
        # Simulate many failed attempts from same IP
        for _ in range(10):
            response = client.post(
                "/api/v1/auth/login",
                json={"email": "test@nexusquantum.com", "password": "wrong"}
            )
            # After 5 attempts, should block
            if _ >= 5:
                assert response.status_code == 429
                break

    def test_2fa_verification(self, client: TestClient, test_user: User):
        """Test 2FA verification (if implemented)."""
        # This assumes 2FA is implemented; we'll test the flow if available.
        # First, enable 2FA for user (requires setup).
        # For now, we just test the verification endpoint if exists.
        response = client.post(
            "/api/v1/auth/2fa/verify",
            json={"code": "123456"},
            headers={"Authorization": f"Bearer {test_user_token}"}
        )
        if response.status_code != 404:
            assert response.status_code in [200, 400]


