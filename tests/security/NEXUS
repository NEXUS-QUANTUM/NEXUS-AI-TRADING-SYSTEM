# ----- Input Validation & Injection Tests -----

class TestInputValidation:
    """Tests for input validation and injection protection."""

    def test_sql_injection(self, client: TestClient, auth_headers: Dict):
        """Test SQL injection protection."""
        # Attempt SQL injection in query parameters
        injection_patterns = [
            "'; DROP TABLE users; --",
            "' OR '1'='1",
            "' UNION SELECT * FROM users --",
            "'; DELETE FROM positions WHERE '1'='1",
        ]
        for pattern in injection_patterns:
            response = client.get(
                f"/api/v1/market/historical/{pattern}",
                headers=auth_headers
            )
            # Should not execute SQL; return 400 or 404
            assert response.status_code in [400, 404, 422]

    def test_xss_protection(self, client: TestClient, auth_headers: Dict):
        """Test XSS protection in input fields."""
        xss_payload = "<script>alert('xss')</script>"
        response = client.put(
            "/api/v1/users/me",
            json={"first_name": xss_payload},
            headers=auth_headers
        )
        # Should sanitize or reject
        assert response.status_code in [200, 400]
        if response.status_code == 200:
            data = response.json()
            assert data.get("first_name") != xss_payload  # Should be sanitized

    def test_malformed_json(self, client: TestClient, auth_headers: Dict):
        """Test handling of malformed JSON."""
        response = client.post(
            "/api/v1/auth/login",
            data="not a json",
            headers={"Content-Type": "application/json"}
        )
        assert response.status_code == 400

    def test_parameter_validation(self, client: TestClient, auth_headers: Dict):
        """Test that invalid parameters are rejected."""
        # Invalid email format
        response = client.post(
            "/api/v1/auth/register",
            json={"email": "invalid", "password": "Test@123"}
        )
        assert response.status_code == 422

        # Negative quantity in order
        response = client.post(
            "/api/v1/trading/orders",
            json={"symbol": "AAPL", "side": "buy", "quantity": -5},
            headers=auth_headers
        )
        assert response.status_code == 422


