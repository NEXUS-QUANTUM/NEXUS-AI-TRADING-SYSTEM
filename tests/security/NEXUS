class TestEncryption:
    """Tests for data encryption at rest."""

    def test_encrypt_decrypt(self):
        """Test encryption and decryption of sensitive data."""
        manager = EncryptionManager()
        plaintext = "sensitive_data_123"
        encrypted = manager.encrypt(plaintext)
        assert encrypted != plaintext
        decrypted = manager.decrypt(encrypted)
        assert decrypted == plaintext

    def test_encryption_of_broker_secrets(self, client: TestClient, auth_headers: Dict):
        """Test that broker API keys are encrypted in the database."""
        response = client.post(
            "/api/v1/brokers/connect",
            json={"broker_type": "alpaca", "api_key": "TEST_KEY", "api_secret": "TEST_SECRET"},
            headers=auth_headers
        )
        assert response.status_code == 201
        data = response.json()
        # The response should not contain the raw secret
        assert "api_secret" not in data or data["api_secret"] is None
        # But in DB it should be encrypted
        db = next(iter(client.app.dependency_overrides.values()))()
        broker = db.query(BrokerAccount).filter(BrokerAccount.id == data["id"]).first()
        assert broker.api_secret_encrypted is not None
        assert broker.api_secret_encrypted != "TEST_SECRET"


